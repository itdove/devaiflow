{
  "_comment": "User-level configuration - personal preferences and workspaces",
  "repos": {
    "workspaces": [
      {
        "name": "primary",
        "path": "~/development"
      }
    ]
  },
  "model_provider": {
    "_comment": "Model provider profiles - easily switch between different AI models",
    "default_profile": "anthropic",
    "_default_profile_comment": "Default provider profile. The profile also selects the agent adapter. Override per session with --model-profile; use --agent only for an explicit adapter override.",
    "profiles": {
      "anthropic": {
        "_comment": "Standard Anthropic API (default)",
        "name": "anthropic",
        "provider": "anthropic",
        "models": {
          "new": "claude-sonnet-4-6",
          "open": "claude-sonnet-4-6",
          "git_new": "claude-haiku-4-5",
          "jira_new": "claude-haiku-4-5",
          "investigation": "claude-sonnet-4-6",
          "commit_message": "claude-haiku-4-5",
          "pr_template": "claude-haiku-4-5"
        }
      },
      "vertex": {
        "_comment": "Google Vertex AI",
        "name": "vertex",
        "provider": "vertex",
        "use_vertex": true,
        "vertex_project_id": "your-gcp-project-id",
        "vertex_region": "us-east5"
      },
      "openrouter-free": {
        "_comment": "OpenRouter with free GPT model",
        "name": "openrouter-free",
        "provider": "openrouter",
        "base_url": "https://openrouter.ai/api",
        "auth_token": "YOUR_OPENROUTER_KEY",
        "api_key": "",
        "model_name": "openai/gpt-oss-120b:free"
      },
      "openrouter-deepseek": {
        "_comment": "OpenRouter with DeepSeek V3.2 (cheapest option)",
        "name": "openrouter-deepseek",
        "provider": "openrouter",
        "base_url": "https://openrouter.ai/api",
        "auth_token": "YOUR_OPENROUTER_KEY",
        "api_key": "",
        "model_name": "deepseek/deepseek-v3.2"
      },
      "lmstudio": {
        "_comment": "LM Studio local server",
        "name": "lmstudio",
        "provider": "custom",
        "base_url": "http://localhost:1234",
        "auth_token": "lmstudio",
        "api_key": "",
        "model_name": "qwen/qwen3-coder-30b"
      },
      "llama-cpp": {
        "_comment": "llama.cpp server (running qwen3-coder)",
        "name": "llama-cpp",
        "provider": "llama.cpp",
        "base_url": "http://localhost:8000",
        "api_key": "",
        "model_name": "Qwen3-Coder-REAP-25B-A3B-GGUF"
      }
    }
  },
  "_model_provider_usage": "Switch profiles with: daf open SESSION --model-profile llama-cpp; use --model only for the session",
  "_model_provider_setup": "See docs/alternative-model-providers.md for setup instructions"
}
